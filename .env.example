# Full-stack Docker profile, as specified in the implementation plan, Section 6.
# Copy to .env and set both database passwords before future runtime setup.
# Blank passwords are intentional: this file contains no usable credentials.
# Do not commit .env, print passwords, or reuse production credentials.
APP_ENV=docker
SPRING_PROFILES_ACTIVE=docker
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Empty for direct documentation; /docs/transactions for a prefix-stripping proxy.
APP_ROOT_PATH=

GOAL_SERVICE_PORT=8080
TXN_SERVICE_PORT=8000

GOAL_DB_HOST=goal-db
GOAL_DB_PORT=5432
GOAL_DB_NAME=goal_db
GOAL_DB_USER=goal_user
GOAL_DB_PASSWORD=

TXN_DB_HOST=transaction-db
TXN_DB_PORT=5432
TXN_DB_NAME=transaction_db
TXN_DB_USER=txn_user
TXN_DB_PASSWORD=

GOAL_SERVICE_BASE_URL=http://goal-service:8080
GOAL_SERVICE_TIMEOUT_SECONDS=3

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT_MS=100
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WARMUP_SECONDS=30
TRUSTED_PROXIES=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
