# Full-stack Docker settings (implementation plan Section 6), read by the root
# docker-compose.yml. Copy to .env and set both database passwords: Compose
# refuses to start while either is blank. Blank passwords are intentional:
# this file contains no usable credentials. Do not commit .env, print
# passwords, or reuse production credentials.
#
# Compose fixes the values that must match the stack's wiring: profiles
# (docker), container ports (8080, 8000), database hosts and ports
# (goal-db:5432, transaction-db:5432) and APP_ROOT_PATH (/docs/transactions,
# because the gateway serves the documentation). They are listed here for the
# configuration matrix; changing them below does not rewire the stack.
APP_ENV=docker
SPRING_PROFILES_ACTIVE=docker
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
APP_ROOT_PATH=/docs/transactions

GOAL_SERVICE_PORT=8080
TXN_SERVICE_PORT=8000

GOAL_DB_HOST=goal-db
GOAL_DB_PORT=5432
GOAL_DB_NAME=goal_db
GOAL_DB_USER=goal_user
GOAL_DB_PASSWORD=

TXN_DB_HOST=transaction-db
TXN_DB_PORT=5432
TXN_DB_NAME=transaction_db
TXN_DB_USER=txn_user
TXN_DB_PASSWORD=

GOAL_SERVICE_BASE_URL=http://goal-service:8080
GOAL_SERVICE_TIMEOUT_SECONDS=3

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT_MS=100
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WARMUP_SECONDS=30
TRUSTED_PROXIES=
GOAL_SERVICE_UPSTREAM=goal-service:8080
TXN_SERVICE_UPSTREAM=transaction-service:8000
# Empty uses the container's DNS (Docker's embedded resolver on Compose networks).
GATEWAY_RESOLVER=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# Application image names in the root stack (default kalash and 0.1.0). A
# deployment pulls registry images instead, for example:
# KALASH_IMAGE_PREFIX=ghcr.io/<owner>/kalash
# KALASH_IMAGE_TAG=1.0.0
