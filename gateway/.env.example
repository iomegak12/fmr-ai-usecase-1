# Standalone gateway settings for gateway/docker-compose.yml (plan Section 6,
# D-07). Copy to .env; contains no secrets. Every value has a default.
# The full stack uses the root .env instead.

# Upstream services as host:port. Standalone, the services run elsewhere and
# publish their ports on the Docker host. On Linux use the host's bridge
# address (for example 172.17.0.1:8080), because nginx resolves names through
# DNS only.
GOAL_SERVICE_UPSTREAM=host.docker.internal:8080
TXN_SERVICE_UPSTREAM=host.docker.internal:8000

# Rate-limit store: the project's own Redis container (redis:6379).
# A short timeout keeps fail-open requests fast.
REDIS_TIMEOUT_MS=100

# D-10/D-11: 100 requests per rolling 60 seconds per client IP on /api/v1/*;
# nothing is limited or counted for 30 seconds after the gateway starts.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WARMUP_SECONDS=30

# D-15: comma-separated IPs or CIDR ranges allowed to set X-Forwarded-For.
# Empty means the TCP peer address is always the client IP.
TRUSTED_PROXIES=

# DNS resolver for upstream and Redis host names. Empty uses the container's
# first nameserver (Docker's embedded DNS on a Compose network).
GATEWAY_RESOLVER=
