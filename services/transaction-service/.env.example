APP_ENV=local
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
TXN_SERVICE_PORT=8000
TXN_DB_HOST=localhost
TXN_DB_PORT=5433
TXN_DB_NAME=transaction_db
TXN_DB_USER=txn_user
# Required. Set a unique local password; never commit .env.
TXN_DB_PASSWORD=
GOAL_SERVICE_BASE_URL=http://localhost:8080
GOAL_SERVICE_TIMEOUT_SECONDS=3
# Empty for direct access. Set /docs/transactions for a prefix-stripping gateway.
APP_ROOT_PATH=
